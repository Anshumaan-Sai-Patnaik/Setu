    android:color="#3314B8A6">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/border_strong" />
        </shape>
    </item>
</ripple>

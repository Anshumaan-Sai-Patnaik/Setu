<?xml version="1.0" encoding="utf-8"?>
<!--
  The launch moment.

  Be clear about what this is: it is the one piece of theatre in the app. Everything
  else that moves on screen is tied to something real - a link that exists, a payload on
  the radio - and this is not. It is a brand beat, and it is here because it was asked
  for, deliberately, with that understood.

  So it is kept honest in the two ways that are still available:

    - It says nothing it cannot back up. No "connecting...", no "starting radio", no
      progress bar counting up to nothing. Just the name and what the name means. A
      false status line during a demo is a claim a judge can catch; a wordmark is not.
    - It gets out of the way fast, and a tap skips it. The app must never be the reason
      somebody is waiting to see the screen that says the network is up.

  Added on top of the Activity's content frame at runtime rather than wrapped around the
  main layout, so nothing about the real screen had to be restructured for it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splash"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <!-- Not fully opaque. The app is genuinely already behind this, blurred where the
         phone can blur, and letting a little of it through says "it is ready" rather
         than "it has not started yet". -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ground"
        android:alpha="0.94" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <!-- The same radar the banner uses, larger. It sweeps because it is set to
             SCANNING - the one view here that was not written for this screen. -->
        <com.example.meshrelay.MeshPulseView
            android:id="@+id/splashPulse"
            android:layout_width="104dp"
            android:layout_height="104dp" />

        <!-- The name, and nothing under it. A gloss explaining the name turns a launch
             screen into a caption, and the word carries itself. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="40sp"
            android:letterSpacing="0.06"
            android:fontFamily="@font/setu_wordmark"
            app:fontFamily="@font/setu_wordmark" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="34dp"
        android:text="tap to skip"
        android:textColor="@color/text_dim"
        android:textSize="11sp"
        android:letterSpacing="0.10" />
</FrameLayout>

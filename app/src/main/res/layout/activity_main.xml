<?xml version="1.0" encoding="utf-8"?>
<!--
  Reading order top to bottom is deliberate, and it is the order a person needs
  things in:

    who am I  ->  is the mesh up  ->  what is it doing  ->  what arrived  ->  report

  The composer sits at the bottom because that is where a thumb is, and because
  reporting is the one thing a frightened person must be able to do without hunting.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ground"
    android:fitsSystemWindows="true"
    android:padding="14dp">

    <!-- ============================================================
         IDENTITY BAR
         Long-press the name to hand this phone the organiser key. Hidden
         on purpose: a staff action, not something a visitor should find.
         ============================================================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <View
            android:id="@+id/vBrandMark"
            android:layout_width="4dp"
            android:layout_height="20dp"
            android:layout_marginEnd="9dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MESH"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RELAY"
            android:textColor="@color/teal"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Becomes the COMMAND CENTRE badge once the key is pasted in. -->
        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="Starting..."
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- ============================================================
         MESH STATE BANNER
         The one thing on screen allowed to shout. It is also the START
         control, so "the mesh is off" and "here is how to turn it on"
         are one object rather than two things to explain.
         ============================================================ -->
    <LinearLayout
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="11dp"
        android:paddingBottom="11dp">

        <!-- The status light, grown into something worth looking at. Every dot in it
             is a real link - see MeshPulseView. -->
        <com.example.meshrelay.MeshPulseView
            android:id="@+id/vMeshDot"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMeshState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MESH OFFLINE"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tvMeshHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Tap to start relaying"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============================================================
         COUNTERS
         A rule the judges cannot see does not exist (Plan.md 17.2). These
         are the decision layer's only visible output, so they get real
         estate and a readable size instead of a monospace footnote.

         Long-press anywhere on this block: store cap 200 <-> 10, so
         eviction becomes watchable, and the rate limit is cleared.
         ============================================================ -->
    <LinearLayout
        android:id="@+id/statsBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_tile"
                android:padding="10dp">

                <TextView
                    android:id="@+id/tvPeers"
                    style="@style/StatValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0" />

                <TextView
                    style="@style/StatCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Phones linked" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_tile"
                android:layout_marginStart="8dp"
                android:padding="10dp">

                <TextView
                    android:id="@+id/tvStored"
                    style="@style/StatValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0" />

                <TextView
                    android:id="@+id/tvStoredCaption"
                    style="@style/StatCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Carrying" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_tile"
                android:layout_marginStart="8dp"
                android:padding="10dp">

                <TextView
                    android:id="@+id/tvFlight"
                    style="@style/StatValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0" />

                <TextView
                    android:id="@+id/tvFlightCaption"
                    style="@style/StatCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="In flight" />
            </LinearLayout>
        </LinearLayout>

        <!-- The second rank of counters. Watched changing during the demo, so
             monospace: digits must not shuffle sideways when 9 becomes 10. -->
        <TextView
            android:id="@+id/tvStats"
            style="@style/MonoCounter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <!-- ============================================================
         PANES
         Three named tabs rather than one button cycling through three
         states: on stage you go straight to the one you want instead of
         tapping past the wrong one in front of an audience.
         ============================================================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_tabbar"
            android:padding="3dp">

            <TextView
                android:id="@+id/tabInbox"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="34dp"
                android:gravity="center"
                android:background="@drawable/tab_item"
                android:textColor="@color/tab_text"
                android:text="INBOX"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tabMap"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="34dp"
                android:gravity="center"
                android:background="@drawable/tab_item"
                android:textColor="@color/tab_text"
                android:text="MAP"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tabLog"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="34dp"
                android:gravity="center"
                android:background="@drawable/tab_item"
                android:textColor="@color/tab_text"
                android:text="LOG"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <!-- Topology lock. Cutting a link in software is what makes a real hop
             visible on three phones that can all hear each other. -->
        <TextView
            android:id="@+id/btnTopology"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/bg_ghost_button"
            android:textColor="@color/text_secondary"
            android:text="LINKS"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPaneTitle"
        style="@style/SectionLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="6dp"
        android:text="Incoming - most urgent first" />

    <!-- ============================================================
         CONTENT
         ============================================================ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="110dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvInbox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="16dp"
            android:text="Nothing yet.\nAnything this phone hears will appear here."
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp" />

        <com.example.meshrelay.ReportMapView
            android:id="@+id/mapView"
            android:background="@drawable/bg_card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- The link graph: who can reach whom. NOT where anyone is standing - the map
             above is the one that means geography, and the graph says so on its own
             footer so that the two can never be confused for each other. -->
        <com.example.meshrelay.MeshGraphView
            android:id="@+id/graphView"
            android:background="@drawable/bg_card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/svLog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_log"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="@color/teal"
                android:lineSpacingExtra="2dp"
                android:textIsSelectable="true" />
        </ScrollView>
    </FrameLayout>

    <!-- ============================================================
         COMPOSER
         The user never types importance. They pick what happened and the
         app decides what that costs the crowd. Fixed choices only: free-text
         urgency makes everything top priority and priority stops meaning
         anything.
         ============================================================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card"
        android:padding="12dp">

        <TextView
            style="@style/SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What is happening?" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/chipRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <EditText
                android:id="@+id/etMessage"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="46dp"
                android:background="@drawable/bg_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:hint="Describe it - what, and where"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_dim"
                android:textSize="14sp"
                android:inputType="text"
                android:imeOptions="actionSend"
                android:maxLines="1"
                android:maxLength="180" />

            <TextView
                android:id="@+id/btnSend"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="SEND"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Opt-in and off by default. This network copies messages onto strangers'
             phones and holds them for hours; that is the wrong place for anyone's
             exact whereabouts unless they chose it. Long-press to type a position. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <CheckBox
                android:id="@+id/chkLoc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Attach my location"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:buttonTint="@color/teal" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvLocState"
                style="@style/MonoCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dim"
                android:text="off" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Always dark, day or night. See values-night/themes.xml, which is deliberately
      identical: this app is used outdoors after dark by someone who may be frightened,
      and a phone that flips to a white screen at 2am is blinding and costs battery on
      a device that is also relaying for other people.
    -->
    <style name="Base.Theme.MeshRelay" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/teal</item>
        <item name="colorOnPrimary">@color/ground</item>
        <item name="colorSecondary">@color/teal_deep</item>
        <item name="colorError">@color/red</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/ground</item>
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_dim</item>
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:navigationBarColor">@color/ground</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <style name="Theme.MeshRelay" parent="Base.Theme.MeshRelay" />

    <!-- ================================================================
         DIALOGS

         Left on Material defaults these came out as a pale sheet with an
         unpadded EditText jammed against the edge - the one place in the app
         that still looked unfinished. Two of them ARE the demo (the organiser
         key, the hand-set position), so they get the same surface, corners and
         hairline as every other card.
         ================================================================ -->
    <style name="ShapeAppearance.MeshRelay.Dialog" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <style name="MaterialAlertDialog.MeshRelay" parent="MaterialAlertDialog.Material3">
        <item name="shapeAppearance">@style/ShapeAppearance.MeshRelay.Dialog</item>
        <item name="backgroundTint">@color/surface</item>
    </style>

    <style name="DialogTitle.MeshRelay" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DialogButton.MeshRelay" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/teal</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="ThemeOverlay.MeshRelay.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/teal</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_dim</item>
        <item name="alertDialogStyle">@style/MaterialAlertDialog.MeshRelay</item>
        <item name="materialAlertDialogTitleTextStyle">@style/DialogTitle.MeshRelay</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogButton.MeshRelay</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButton.MeshRelay</item>
        <item name="buttonBarNeutralButtonStyle">@style/DialogButton.MeshRelay</item>
    </style>

    <!-- ================================================================
         Text roles. Named for what they mean, not what they look like.
         ================================================================ -->

    <!-- Small caps, widely tracked. Labels a section without competing with it. -->
    <style name="SectionLabel">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- The number on a stat tile. Big enough to read from the judges' table. -->
    <style name="StatValue">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="StatCaption">
        <item name="android:textSize">9sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.10</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Counters that are watched changing during the demo, so they are monospace:
         digits must not shuffle sideways when 9 becomes 10. -->
    <style name="MonoCounter">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>
